#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        ltaphold: ltaphold {
            compatible = "zmk,behavior-hold-tap";
            label = "LTAPHOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <54 44 55 43 30 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 55 56 57 6 7 8 9 10 11>;
        };

        rtaphold: rtaphold {
            compatible = "zmk,behavior-hold-tap";
            label = "RTAPHOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
            tapping-term-ms = <150>;
        };

        thumb: thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        std {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC       &kp N1             &kp N2            &kp N3             &kp N4              &kp N5                                              &kp N6              &kp N7              &kp N8             &kp N9            &kp N0                &kp BACKSPACE
&kp TAB       &kp Q              &kp W             &kp E              &kp R               &kp T                                               &kp Y               &kp U               &kp I              &kp O             &kp P                 &kp MINUS
&kp CAPSLOCK  &ltaphold LMETA A  &ltaphold LALT S  &ltaphold LCTRL D  &ltaphold LSHIFT F  &kp G                                               &kp H               &rtaphold RSHIFT J  &rtaphold RCTRL K  &rtaphold RALT L  &rtaphold RMETA SEMI  &kp SQT
&kp LCTRL     &kp Z              &kp X             &kp C              &kp V               &kp B         &kp C_PLAY_PAUSE    &kp C_PLAY_PAUSE  &kp N               &kp M               &kp COMMA          &kp DOT           &kp FSLH              &kp RCTRL
                                                   &kp LALT           &thumb 3 RS(ESC)    &thumb 1 TAB  &kp SPACE           &kp ENTER         &thumb 2 BACKSPACE  &mo 4               &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans         &trans                &trans                 &trans          &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans          &kp MINUS      &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp GRAVE      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp APOSTROPHE  &kp SEMICOLON  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp BACKSLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans          &kp SLASH      &trans
                        &trans  &trans  &trans  &trans    &trans  &trans         &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav {
            bindings = <
&trans  &trans      &trans      &trans    &trans     &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_PRV  &bt BT_NXT  &kp UP    &trans     &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp HOME    &kp LEFT    &kp DOWN  &kp RIGHT  &kp END                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans    &trans     &trans   &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans    &trans     &trans   &trans    &trans  &trans  &trans  &trans
            >;
        };

        num {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans      &trans  &trans  &trans        &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp EQUAL   &kp N7  &kp N8  &kp N9        &kp MINUS    &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp PERIOD  &kp N4  &kp N5  &kp NUMBER_6  &kp KP_PLUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N0      &kp N1  &kp N2  &kp NUMBER_3  &kp SLASH    &trans
                        &trans  &trans  &trans  &trans    &trans  &trans      &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        off {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T                     &kp Y   &kp U   &kp I      &kp O    &kp P     &trans
&trans  &kp A   &kp S   &kp D   &kp F   &kp G                     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B   &trans    &trans  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
